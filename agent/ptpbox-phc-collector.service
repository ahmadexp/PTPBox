[Unit]
Description=PTPBox isolated raw PHC collector
After=network.target systemd-tmpfiles-setup.service

[Service]
Type=simple
User=@PTPBOX_USER@
Group=@PTPBOX_GROUP@
SupplementaryGroups=clock
Environment=PTPBOX_ROOT=@PTPBOX_ROOT@
Environment=PTPBOX_STATE_DIR=@PTPBOX_ROOT@/runtime
Environment=PTPBOX_LOG_DIR=/var/log/ptpbox
Environment=PTPBOX_TOPOLOGY=/etc/ptpbox/topology.json
Environment=PTPBOX_PHC_STORE=/run/ptpbox/phc-samples.sqlite3
ExecStart=/usr/bin/python3 /opt/ptpbox-web/agent/ptpbox_phc_collector.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
